{
  "manifest_version": 3,
  "name": "CookieSync: syncs cookies to localhost",
  "version": "1.3.0",
  "description": "Copies cookies to localhost",
  "homepage_url": "https://github.com/wilsonyiyi/cookiesync",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_icon": {
      "48": "icon38.png"
    },
    "default_title": "Copies cookies to localhost",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://localhost:*/*"],
      "js": ["form-backup.js"],
      "run_at": "document_start"
    }
  ]
}
